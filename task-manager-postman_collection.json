            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"register succeeded\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"jwt\", json.data.token);",
                  "}"
